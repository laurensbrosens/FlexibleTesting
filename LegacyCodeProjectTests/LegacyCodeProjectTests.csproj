<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="8.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" Version="8.9.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.4.0" />
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <PackageReference Include="NUnit" Version="4.5.1" />
    <PackageReference Include="NUnit.Analyzers" Version="4.12.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
  </ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\LegacyCodeProject\LegacyCodeProject.csproj" />
		<ProjectReference Include="..\FlexibleTesting.Tasks\FlexibleTesting.Tasks.csproj" ReferenceOutputAssembly="false" />
	</ItemGroup>

	<ItemGroup>
		<!-- Feed Project A sources to the task (no need to edit Project A) -->
		<LegacyCodeSources Include="..\LegacyCodeProject\**\*.cs" Exclude="..\LegacyCodeProject\bin\**\*;..\LegacyCodeProject\obj\**\*;..\LegacyCodeProject\**\*.g.cs" />
	</ItemGroup>

	<!-- Visual Studio / Full MSBuild -->
	<UsingTask TaskName="FlexibleTesting.Tasks.FlexibleTestingTask" AssemblyFile="..\FlexibleTesting.Tasks\bin\Debug\net472\FlexibleTesting.Tasks.dll" TaskFactory="TaskHostFactory"
			   Condition="'$(MSBuildRuntimeType)' == 'Full'" />

	<!-- dotnet build / Core MSBuild -->
	<UsingTask TaskName="FlexibleTesting.Tasks.FlexibleTestingTask" AssemblyFile="..\FlexibleTesting.Tasks\bin\Debug\net10.0\FlexibleTesting.Tasks.dll" TaskFactory="TaskHostFactory"
			   Condition="'$(MSBuildRuntimeType)' != 'Full'" />

	<Target Name="GenerateFlexibleTesting" BeforeTargets="CoreCompile" AfterTargets="ResolveReferences;ResolveProjectReferences">
		<FlexibleTestingTask ProjectFilePath="$(MSBuildProjectFullPath)" OutputPath="$(MSBuildProjectDirectory)\Generated" 
							 SourceFiles="@(Compile)" References="@(ReferencePath)" LegacySourceFiles="@(LegacyCodeSources)" 
							 LegacyAssemblyName="LegacyCodeProject" DefineConstants="$(DefineConstants)" />
	</Target>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

</Project>
